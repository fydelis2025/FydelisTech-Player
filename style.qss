QWidget {
    background: #050505;
    color: #88FF99;
    font-family: "Consolas", "Courier New", monospace;
    font-size: 13px;
}
QMainWindow { border: 2px solid #00FF41; }
QFrame#centralFrame {
    background: #080808;
    border: 1px solid #00FF41;
    border-radius: 8px;
}
QLabel#title {
    font-size: 20px; font-weight: bold;
    color: #00FF41;
}
QLabel#videoArea {
    background: #000;
    border: 1px solid #00FF41;
    min-height: 340px;
}
QLabel#timeDisplay {
    font-size: 18px;
    color: #00FF41;
    font-weight: bold;
}
QPushButton {
    background: #0f0f0f;
    border: 1px solid #00FF41;
    border-radius: 4px;
    color: #00FF41;
    padding: 8px 14px;
    font-weight: bold;
}
QPushButton:hover { background: #00FF41; color: #000; }
QPushButton:pressed { background: #00CC33; border-color: #00CC33; }
QLineEdit {
    background: #0a0a0a;
    border: 1px solid #00FF41;
    border-radius: 4px;
    padding: 6px;
    color: #88FF99;
}
QLineEdit:focus { border-color: #00D8FF; }
QSlider::groove:horizontal { height: 6px; background: #111; border-radius: 3px; }
QSlider::handle:horizontal {
    background: #00FF41; width: 14px; margin: -5px 0; border-radius: 7px;
}
QSlider::sub-page:horizontal { background: #00FF41; border-radius: 3px; }
QStatusBar { border-top: 1px solid #003300; color: #00D8FF; }